# Google Gemini API Configuration (Free tier)
# GOOGLE_API_KEY=FILL_HERE

# Redis Configuration (for Bull queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Queue/inline analysis behavior
# Set USE_REDIS_QUEUE=false on Render to run without Redis/worker.
USE_REDIS_QUEUE=true
# If queue is unavailable, run analysis in-process on the web service.
ENABLE_INLINE_ANALYSIS_FALLBACK=true
# Safety cap for admin "re-run all" when queue is unavailable.
INLINE_ADMIN_RERUN_MAX=25

# Server Configuration
PORT=3000
NODE_ENV=development

# LLM Configuration
# Options: 'ollama' (local), 'gemini' (cloud)
LLM_PROVIDER=ollama

# Ollama (local LLM running on home PC via Cloudflare Tunnel)
# ollama serve
# cloudflared tunnel --url http://localhost:11434
# Set this to your Cloudflare Tunnel URL for remote access, or http://localhost:11434 for local
OLLAMA_URL=https://icons-shuttle-favourite-quote.trycloudflare.com/
OLLAMA_MODEL=qwen2.5vl:7b

# Hybrid local evidence processing limits
PDF_TEXT_MAX_CHARS=6000
PDF_MAX_FILES=3
IMAGE_MAX_FILES=6


